                                    </div>
                                    <div class="col-xs-3 col-sm-3">
                                        <img src="img/clan/galaxy/Christopher.jpg" class="img-circle" width="100%" />
                                        <p>Christopher (MAE (PG))</p>
                                    </div>
                                    <div class="col-xs-3 col-sm-3">
                                        <img src="img/clan/galaxy/Enlai.jpeg" class="img-circle" width="100%" />
                                        <p>Enlai (CENG)</p>
                                    </div>
                                    <div class="col-xs-3 col-sm-3">
                                        <img src="img/clan/galaxy/Floren.jpeg" class="img-circle" width="100%" />
                                        <p>Floren (RMBI)</p>
                                    </div>
                                </div>
                                <div class="row">
                                    <div class="col-xs-3 col-sm-3">

                                        <p>Clement (RMBI)</p>
                                    </div>
                                    <div class="col-xs-3 col-sm-3">
                                        <img src="img/clan/inno/Eugene.jpg" class="img-circle" width="100%" />
                                        <p>Eugene (CIVL + AI)</p>
                                    </div>
                                </div>
                                <div class="row">

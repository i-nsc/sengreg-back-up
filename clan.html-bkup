                                    <div class="col-xs-3 col-sm-3">
                                        <img src="img/clan/galaxy/Wesley.jpg" class="img-circle" width="100%" />
                                        <p>Wesley (CSE)</p>
                                    </div>
                                    <div class="col-xs-3 col-sm-3">

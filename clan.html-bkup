                                        <img src="img/clan/eden/Crystal.jpg" class="img-circle" width="100%" />
                                        <p>Crystal (CPEG)</p>
                                    </div>
                                    <div class="col-xs-3 col-sm-3">
                                        <img src="img/clan/eden/Furgy.jpg" class="img-circle" width="100%" />
                                        <p>Furgy (CSE)</p>
                                    </div>
                                    <div class="col-xs-3 col-sm-3">
                                        <img src="img/clan/eden/James.jpg" class="img-circle" width="100%" />
                                        <p>James (BIEN))</p>
                                    </div>
                                </div>

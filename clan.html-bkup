                      <th>25 Aug 2022 (Thu), 3:00PM - 5:00PM</th>
                    </tr>
                    <tr>
                      <th><span style="color:#747474;">Clan 6 Nova</span></th>
                      <th><span style="color:#747474;">T21-T24</span></th>
                      <th>25 Aug 2022 (Thu), 1:00PM - 2:30PM</th>
                    </tr>
                    <tr>
                      <th><span style="color:#1C369A;">Clan 7 Xeno</span></th>
                      <th><span style="color:#1C369A;">T25-T28</span></th>
                      <th>25 Aug 2022 (Thu), 11:00AM - 1:00PM</th>
                    </tr>
                    <tr>
                      <th><span style="color:#8F70AA;">Clan 8 Maestro</span></th>
